{
  "api": 1,
  "id": "mega-drive",
  "name": "Mega Drive",
  "version": "1.1.0",
  "author": "romforge",
  "licence": "MIT",
  "description": "Near-black and glossy, a red accent, bold condensed type; a list by default.",
  "layout": "list",
  "layouts": ["grid", "cover-flow", "wheel", "shelves", "hero", "hero-bottom"],
  "fallback": "platform",
  "schemes": {
    "black": {
      "--fs-bg": "#0b0b0d",
      "--fs-bg-2": "#26262b",
      "--fs-panel": "#18181c",
      "--fs-text": "#f2f2f4",
      "--fs-muted": "#a2a2ac",
      "--fs-accent": "#d8231f",
      "--fs-accent-text": "#ffffff",
      "--fs-line": "#ffffff1a",
      "--fs-focus": "#d8231f",
      "--fs-radius": "0.4vh",
      "--fs-title-font": "\"Arial Narrow\", \"Liberation Sans Narrow\", \"Roboto Condensed\", sans-serif"
    }
  },
  "options": [
    {
      "key": "gloss",
      "label": "Gloss",
      "choices": [
        { "value": "on", "label": "On" },
        { "value": "off", "label": "Off" }
      ]
    }
  ]
}
