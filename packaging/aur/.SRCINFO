pkgbase = romforge
	pkgdesc = Identify, tidy and play your ROM collection
	pkgver = 0.16.0
	pkgrel = 1
	url = https://github.com/asafelobotomy/romforge
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = nodejs
	makedepends = npm
	depends = webkit2gtk-4.1
	depends = gtk3
	depends = glib2
	depends = libsoup3
	depends = cairo
	depends = gdk-pixbuf2
	depends = dbus
	depends = hicolor-icon-theme
	depends = glibc
	depends = libgcc
	depends = systemd-libs
	depends = libayatana-appindicator
	optdepends = retroarch: play games (with its cores)
	optdepends = libretro-scummvm: ScummVM games in RetroArch
	optdepends = scummvm: ScummVM games, and naming them
	optdepends = mame: Arcade, FM-7 and FM Towns games
	optdepends = flatpak: DOSBox Staging or DOSBox-X from Flathub
	optdepends = gtk-layer-shell: the radial menu over a fullscreen game
	optdepends = gst-plugins-good: music in the fullscreen mode (MP3, FLAC, WAV)
	optdepends = gst-libav: music in M4A/AAC
	optdepends = uq: your games in Spotlight on uQ, its game-mode window rule and its theme
	conflicts = romforge-bin
	options = !lto
	source = romforge-0.16.0.tar.gz::https://github.com/asafelobotomy/romforge/archive/refs/tags/v0.16.0.tar.gz
	sha256sums = SKIP

