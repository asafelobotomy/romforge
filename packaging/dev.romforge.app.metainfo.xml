<component type="desktop-application">
  <id>dev.romforge.app</id>
  <name>romforge</name>
  <summary>Identify, tidy and play your ROM collection</summary>
  <description>
    <p>romforge identifies the games in your ROM folders, names and sorts them, finds their cover art, and starts each one in the right emulator.</p>
    <p>It knows dozens of systems, from home consoles and handhelds to arcade and home computers, and has a fullscreen mode for the couch.</p>
  </description>
