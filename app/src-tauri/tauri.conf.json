{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "romforge",
  "version": "0.18.1",
  "identifier": "dev.romforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cargo build --release --locked -p romforge-cli -p romforge-provider",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "romforge",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' theme: http://theme.localhost; img-src 'self' data: art: http://art.localhost theme: http://theme.localhost; font-src 'self' theme: http://theme.localhost; media-src blob:; connect-src 'self' ipc: http://ipc.localhost art: http://art.localhost music: http://music.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "category": "Game",
    "shortDescription": "Identify, tidy and play your ROM collection",
    "longDescription": "romforge identifies ROMs and disc images against No-Intro, Redump and TOSEC DATs, keeps them in one RomForge folder with their art and metadata, and starts them in RetroArch or a standalone emulator.",
    "license": "MIT",
    "homepage": "https://github.com/asafelobotomy/romforge",
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/romforge-cli": "../../target/release/romforge-cli",
          "/usr/bin/romforge-provider": "../../target/release/romforge-provider",
          "/usr/share/uq/launcher/romforge.provider": "../../uq/launcher/romforge.provider",
          "/usr/share/dbus-1/services/org.romforge.Provider.service": "../../uq/dbus/org.romforge.Provider.service",
          "/usr/share/uq/integrations/romforge/rules.toml": "../../uq/integrations/romforge/rules.toml",
          "/usr/share/uq/settings/pages/romforge/AntivirusSection.qml": "../../uq/pages/romforge/AntivirusSection.qml",
          "/usr/share/uq/settings/pages/romforge/av.js": "../../uq/pages/romforge/av.js",
          "/usr/share/uq/settings/pages/romforge/BiosSection.qml": "../../uq/pages/romforge/BiosSection.qml",
          "/usr/share/uq/settings/pages/romforge/FoldersSection.qml": "../../uq/pages/romforge/FoldersSection.qml",
          "/usr/share/uq/settings/pages/romforge/GamesSection.qml": "../../uq/pages/romforge/GamesSection.qml",
          "/usr/share/uq/settings/pages/romforge/LibrarySection.qml": "../../uq/pages/romforge/LibrarySection.qml",
          "/usr/share/uq/settings/pages/romforge/ListsSection.qml": "../../uq/pages/romforge/ListsSection.qml",
          "/usr/share/uq/settings/pages/romforge/Page.qml": "../../uq/pages/romforge/Page.qml",
          "/usr/share/uq/settings/pages/romforge/RecentSection.qml": "../../uq/pages/romforge/RecentSection.qml",
          "/usr/share/uq/settings/pages/romforge/logic.js": "../../uq/pages/romforge/logic.js",
          "/usr/share/uq/settings/pages/romforge/page.toml": "../../uq/pages/romforge/page.toml",
          "/usr/share/doc/romforge/copyright": "../../LICENSE"
        },
        "depends": [
          "libayatana-appindicator3-1"
        ],
        "recommends": [
          "retroarch",
          "scummvm",
          "libgtk-layer-shell0",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ],
        "section": "games"
      },
      "rpm": {
        "files": {
          "/usr/bin/romforge-cli": "../../target/release/romforge-cli",
          "/usr/bin/romforge-provider": "../../target/release/romforge-provider",
          "/usr/share/uq/launcher/romforge.provider": "../../uq/launcher/romforge.provider",
          "/usr/share/dbus-1/services/org.romforge.Provider.service": "../../uq/dbus/org.romforge.Provider.service",
          "/usr/share/uq/integrations/romforge/rules.toml": "../../uq/integrations/romforge/rules.toml",
          "/usr/share/uq/settings/pages/romforge/AntivirusSection.qml": "../../uq/pages/romforge/AntivirusSection.qml",
          "/usr/share/uq/settings/pages/romforge/av.js": "../../uq/pages/romforge/av.js",
          "/usr/share/uq/settings/pages/romforge/BiosSection.qml": "../../uq/pages/romforge/BiosSection.qml",
          "/usr/share/uq/settings/pages/romforge/FoldersSection.qml": "../../uq/pages/romforge/FoldersSection.qml",
          "/usr/share/uq/settings/pages/romforge/GamesSection.qml": "../../uq/pages/romforge/GamesSection.qml",
          "/usr/share/uq/settings/pages/romforge/LibrarySection.qml": "../../uq/pages/romforge/LibrarySection.qml",
          "/usr/share/uq/settings/pages/romforge/ListsSection.qml": "../../uq/pages/romforge/ListsSection.qml",
          "/usr/share/uq/settings/pages/romforge/Page.qml": "../../uq/pages/romforge/Page.qml",
          "/usr/share/uq/settings/pages/romforge/RecentSection.qml": "../../uq/pages/romforge/RecentSection.qml",
          "/usr/share/uq/settings/pages/romforge/logic.js": "../../uq/pages/romforge/logic.js",
          "/usr/share/uq/settings/pages/romforge/page.toml": "../../uq/pages/romforge/page.toml",
          "/usr/share/licenses/romforge/LICENSE": "../../LICENSE"
        },
        "depends": [
          "libayatana-appindicator-gtk3"
        ],
        "recommends": [
          "retroarch",
          "scummvm",
          "gtk-layer-shell",
          "gstreamer1-plugins-good",
          "gstreamer1-plugin-libav"
        ]
      }
    },
    "publisher": "asafelobotomy"
  }
}
